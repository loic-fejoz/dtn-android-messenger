# Fastlane Screengrab configuration file
# https://docs.fastlane.tools/getting-started/android/screenshots/

# Locales to capture screenshots for
locales(['fr-FR', 'en-US'])

# Clear previous screenshots before taking new ones
clear_previous_screenshots(true)

# Do not append timestamp suffix to filenames to match screencap*.png
use_timestamp_suffix(false)

# Path to built APKs
app_apk_path('app/build/outputs/apk/debug/app-debug.apk')
tests_apk_path('app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk')

# Directory where screenshots will be saved
output_directory('fastlane/metadata/android')
